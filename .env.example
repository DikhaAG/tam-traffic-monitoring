# Database (PostgreSQL)
DATABASE_URL=postgres://tam_user:tam_secret_password@localhost:5433/tam_db
POSTGRES_USER=tam_user
POSTGRES_PASSWORD=tam_secret_password
POSTGRES_DB=tam_db
POSTGRES_PORT=5433

# Cache & Streaming (Redis)
REDIS_URL=redis://127.0.0.1:6380
REDIS_PORT=6380

# TAM API Server
API_HOST=0.0.0.0
API_PORT=4000
JWT_SECRET=super_secret_tam_jwt_key_change_me_in_production
AGENT_SHARED_TOKEN=tam_agent_secure_token_change_me_in_production

# Telegram Incident Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/live

